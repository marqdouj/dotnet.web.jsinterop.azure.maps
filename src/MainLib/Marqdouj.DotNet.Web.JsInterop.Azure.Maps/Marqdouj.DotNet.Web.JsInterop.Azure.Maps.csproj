<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageIcon>DMNuGet.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>11.0.0-Preview-1.1</Version>
    <Title>.NET library for working with Azure Maps in JavaScript interop scenarios.</Title>
    <PackageProjectUrl>https://github.com/marqdouj/dotnet.web.jsinterop.azure.maps</PackageProjectUrl>
    <PackageTags>Blazor JSInterop Map Azure</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <Authors>Douglas Marquardt</Authors>
    <Copyright>© Douglas Marquardt. All rights reserved.</Copyright>
    <Description>Designed for Blazor interaction with the Azure Maps SDK</Description>
  </PropertyGroup>

	<Target Name="NpmBuild" AfterTargets="CoreCompile">
		<Exec Command="call npm run build:webpack" />
	</Target>

	<Target Name="RemoveTsGenAsContent" AfterTargets="CoreCompile">
		<ItemGroup>
			<Content Remove="tsgen\**" />
		</ItemGroup>
	</Target>

	<ItemGroup>
	  <Content Remove="package-lock.json" />
	  <Content Remove="package.json" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\..\DMNuGet.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="package-lock.json" />
	  <None Include="package.json" />
	</ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Marqdouj.DotNet.Web.JsInterop.GeoJson" Version="10.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-preview.4.26230.115" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="7.0.0-beta">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Update="tsconfig.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		<Pack>False</Pack>
    </Content>
  </ItemGroup>

</Project>
