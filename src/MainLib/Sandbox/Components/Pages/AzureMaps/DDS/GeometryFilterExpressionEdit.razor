<FluentStack>
    <FluentTextInput Disabled="@Disabled" Label="Operator" @bind-Value="@FilterExpression.ExpressionOperator" />
    <FluentSelect Disabled="@Disabled" Label="Geometry Type" Items="@GeometryTypes" @bind-Value="@FilterExpression.GeometryType"/>
</FluentStack>

@code {
    [Parameter, EditorRequired]
    public GeometryFilterExpression FilterExpression { get; set; }

    [Parameter, EditorRequired]
    public List<string> GeometryTypes { get; set; }

    [Parameter]
    public bool Disabled { get; set; }
}
