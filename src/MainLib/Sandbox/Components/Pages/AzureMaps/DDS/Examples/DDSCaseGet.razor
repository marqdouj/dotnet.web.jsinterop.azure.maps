@page "/map-dds-CaseGet"
@rendermode InteractiveServer
@inject ILogger<DDSCaseGet> Logger
@inject INotificationService ToastService
@inject AzureMapsXmlDocReader DocReader
@inject IMapDataService MapDataService

<MapPage Title="@title">
    <SummaryContent>
        <FluentText As="@TextTag.Paragraph">
	        This is an example of how to use the
	        <FluentLink Href="map-dds-method-CaseGet" Target="LinkTarget.Blank">@title</FluentLink>
	        method.
            <br />
            Each bubble on the map represents a different zone, and the color of the bubble indicates the zone's status (red, yellow, or green).
            Blue is the default color if the bubble does not have a 'zoneColor' property.
            <br />
            <br />
            Code: <code>layer.Options.Color = DDSBuilder.CaseGet("zone", "zoneColor", "blue");</code>
            <br />
            JSON: <code>@ddsJSON</code>
            <br />
            <br />
            Optionally, you could just check for the 'zoneColor' property and use that value directly.
            <br />
            Code: <code>layer.Options.Color = DDSBuilder.CaseGet("zoneColor", "zoneColor", "blue");</code>
        </FluentText>
    </SummaryContent>
    <ChildContent>
        <Toolbar>
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.ArrowReset())" Title="Reset" OnClick="@Reset" />
            <FluentSpacer Width="10px" />
        </Toolbar> 

        <MapControl MapId="@mapId" />

        <FluentOverlay @bind-Visible="@overlay" FullScreen="true">
            <FluentSpinner />
        </FluentOverlay>
    </ChildContent>
</MapPage>

<MapProvider OnMapProviderInitialized="@OnMapProviderInitialized"
             OnMapEventError="@OnMapEventError"
             OnMapEventReady="@OnMapEventReady" />

@code {
    private const string name = nameof(DDSBuilder.CaseGet);
    private string title => $"DDS - {name}";
    private string mapId = $"map{name}";
    private IAzureMapsInterop? maps;
    private bool mapReady;
    private bool mapNotReady => !mapReady;
    private bool overlay;
    private bool buttonsDisabled => mapNotReady | overlay;
    private readonly MapOptions mapOptions = MapExtensions.GetDefaultMapOptions(zoomLevel: 12);
    private readonly BubbleLayer bubbleLayer = (BubbleLayer)LayerType.Bubble.GetDefaultLayer();
    private string? ddsJSON = "";

    #region Map Provider Handlers

    private async Task OnMapProviderInitialized(MapProviderArgs args)
    {
        try
        {
            maps = await args.ProcessMapProviderInitialized(Logger, ToastService);
            if (maps != null)
                await maps.CreateDefaultMap(mapId, Logger, ToastService, mapOptions);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task OnMapEventError(MapEventArgs args)
    {
        await args.ProcessMapEventError(Logger, ToastService);
    }

    private async Task OnMapEventReady(MapEventArgs args)
    {
        try
        {
            mapReady = !(await args.HasPayloadError(Logger, ToastService));
            ShowOverlay(true);

            ddsJSON = DDSBuilder.CaseGet("zone", "zoneColor", "blue", true).ToString();

            bubbleLayer.Options = new() { Blur = 0.25, Color = DDSBuilder.CaseGet("zone", "zoneColor", "blue"), Radius = 20, StrokeColor = "LightSteelBlue", StrokeWidth = 3 };

            var data = await MapDataService.GetBubbleLayerData();
            var points = data.Select(e => new MapFeature(new Point(e.Longitude, e.Latitude))).ToList();

            for (int i = 0; i < points.Count; i++)
            {
                var point = points[i];
                point.Properties ??= new Properties();
                var color = "";
                switch (i)
                {
                    case 0:
                        color = "red";
                        break;
                    case 1:
                        color = "yellow";
                        break;
                    case 2:
                        color = "green";
                        break;
                    default:
                        color = "";
                        break;
                }

                if (!string.IsNullOrEmpty(color))
                {
                    point.Properties.Add("zone", i);
                    point.Properties.Add("zoneColor", color);
                }
            }

            await maps!.Layers.Add(mapId, bubbleLayer);
            await maps!.Features.Add(mapId, points, bubbleLayer.DataSource.Id);
            
            mapOptions.Camera!.Center = data[1];
            await maps!.Configuration.ZoomTo(mapId, mapOptions.Camera!.Center, mapOptions.Camera.Zoom);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            ShowOverlay(false);
        }
    }

    # endregion

    #region MapsInterop

    private async Task Reset()
    {
        if (mapReady)
            await maps!.ResetMap(mapId, Logger, ToastService, mapOptions);
    }

    private void ShowOverlay(bool isVisible)
    {
        overlay = isVisible;
        StateHasChanged();
    }

    #endregion
}
