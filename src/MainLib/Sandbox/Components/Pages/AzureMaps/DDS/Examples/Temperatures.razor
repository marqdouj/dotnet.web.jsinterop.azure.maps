@page "/map-dds-temperatures"
@rendermode InteractiveServer
@inject ILogger<Temperatures> Logger
@inject INotificationService ToastService
@inject IMapDataService DataService

<MapPage Title="Temperatures">
    <SummaryContent>
        <FluentLabel>
            This example demonstrates visualizing temperature data using DDS. 
            The map displays different colored bubbles representing temperature ranges (cool, mild, warm, hot) at various locations. 
            A legend is provided to indicate the temperature ranges corresponding to each color. 
            <br />
            When a user hovers over a temperature, a popup appears with the location.
        </FluentLabel>
        <DDSLink/>
    </SummaryContent>
    <ChildContent>
        <Toolbar>
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.ArrowReset())" Title="Reset" OnClick="@Reset" />
        </Toolbar>

        <FluentStack>
            <FluentStack Orientation="Orientation.Vertical" Height="500px" Width="260px">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="5px" Width="200px">
                    <FluentLabel Weight="LabelWeight.Semibold">Legend</FluentLabel>
                    <FluentCard>
                        <FluentStack HorizontalGap="3px" VerticalAlignment="VerticalAlignment.Center">
                            <div style="@coolStyle" />
                            <FluentLabel>Cool (20°C)</FluentLabel>
                        </FluentStack>
                        <FluentStack HorizontalGap="3px" VerticalAlignment="VerticalAlignment.Center">
                            <div style="@mildStyle" />
                            <FluentLabel>Mild (21°C)</FluentLabel>
                        </FluentStack>
                        <FluentStack HorizontalGap="3px" VerticalAlignment="VerticalAlignment.Center">
                            <div style="@warmStyle" />
                            <FluentLabel>Warm (22°C)</FluentLabel>
                        </FluentStack>
                        <FluentStack HorizontalGap="3px" VerticalAlignment="VerticalAlignment.Center">
                            <div style="@hotStyle" />
                            <FluentLabel>Hot (23°C)</FluentLabel>
                        </FluentStack>
                    </FluentCard>
                </FluentStack>
            </FluentStack>
            <MapControl MapId="@mapId" />
        </FluentStack>

        <FluentOverlay @bind-Visible="@overlay" FullScreen="true">
            <FluentSpinner />
        </FluentOverlay>
    </ChildContent>
</MapPage>

<MapProvider OnMapProviderInitialized="@OnMapProviderInitialized"
             OnMapEventError="@OnMapEventError"
             OnMapEventReady="@OnMapEventReady" />

@code {
    private const string mapId = "mapTemperatures";
    private IAzureMapsInterop? maps;
    private bool mapReady;
    private bool mapNotReady => !mapReady;
    private bool overlay;
    private bool buttonsDisabled => mapNotReady | overlay;
    private readonly MapOptions mapOptions = MapExtensions.GetDefaultMapOptions(zoomLevel: 12);
    private readonly BubbleLayer bubbleLayer = (BubbleLayer)LayerType.Bubble.GetDefaultLayer();
    private readonly SymbolLayer symbolLayer = (SymbolLayer)LayerType.Symbol.GetDefaultLayer();
    private List<TemperatureInfo> temperatures = new();
    private List<MapFeature> features = new();
    private const string coolColor = "blue";
    private const string mildColor = "yellow";
    private const  string warmColor = "orange";
    private const string hotColor = "red";
    private readonly string coolStyle = $"background-color: {coolColor};width:1rem;height:1rem;";
    private readonly string mildStyle = $"background-color: {mildColor};width:1rem;height:1rem;";
    private readonly string warmStyle = $"background-color: {warmColor};width:1rem;height:1rem;";
    private readonly string hotStyle = $"background-color: {hotColor};width:1rem;height:1rem;";

    protected override async Task OnInitializedAsync()
    {
        temperatures = await DataService.GetTemperatureLayerData();
        mapOptions.Camera!.Center = temperatures[1].Position;

        var bubbleColor = DDSBuilder.LinearInterpolate("temperature", new List<(double Value, string Color)>
        {
            ( 20, coolColor ),
            ( 21, mildColor ),
            ( 22, warmColor ),
            ( 23, hotColor )
        });

        bubbleLayer.Options = new() { Blur = 0.25, Color = bubbleColor, Radius = 20, StrokeColor = "LightSteelBlue", StrokeWidth = 3 };
        symbolLayer.Options = new() { IconOptions = new SymbolIconOptions { AllowOverlap = true, Image = "none" }, TextOptions = new SymbolTextOptions { Color = "black", HaloColor = "white", HaloWidth = 2, Offset = new[] { 0, 0.25 }, TextField = DDSBuilder.ConcatGet("temperature", "°C") } };
        symbolLayer.Source = bubbleLayer.Source;

        features = temperatures.Select(temp => new MapFeature(new Point(temp.Position))
        {
            Properties = new Properties
            {
                { "temperature", temp.Temperature },

                //optional, not required if using tooltip property
                { "description", temp.Description }, 

                //optional if using description property. If missing the hover popup will just show the description property.
                //This is just to demonstrate how you could customize the hover popup content with HTML.
                //{ "tooltip", $"<b>{temp.Description}</b>" }, 
            }
        }).ToList();
    }

    private async Task LoadLayers()
    {
        try
        {
            ShowOverlay(true);
            await maps!.Layers.Add(mapId, bubbleLayer);
            await maps!.Layers.Add(mapId, symbolLayer);
            await maps.Features.Add(mapId, features, bubbleLayer.Source.Id);

            //Add the hover popup to the symbol layer (you can also add it to the bubble layer but it works better in the symbol layer). 
            Popup popup = new() { Options = new PopupOptions { CloseButton = false } };

            //Add customization to the popup if desired to override the default template, for example:
            // popup.Options.FillColor = "SlateGray";
            // popup.Options.Content = "<div style=\"padding:8px;border-radius:6px;color:black\">{tooltip}</div>";

            await maps.Layers.AddHoverPopup(mapId, symbolLayer.Id, popup);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            ShowOverlay(false);
        }
    }

    #region Map Provider Handlers

    private async Task OnMapProviderInitialized(MapProviderArgs args)
    {
        try
        {
            maps = await args.ProcessMapProviderInitialized(Logger, ToastService);
            if (maps != null)
                await maps.CreateDefaultMap(mapId, Logger, ToastService, mapOptions);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task OnMapEventError(MapEventArgs args)
    {
        await Task.CompletedTask;
        await args.ProcessMapEventError(Logger, ToastService);
    }

    private async Task OnMapEventReady(MapEventArgs args)
    {
        try
        {
            mapReady = !(await args.HasPayloadError(Logger, ToastService));
            await LoadLayers();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            ShowOverlay(false);
        }
    }

    # endregion

    #region MapsInterop

    private async Task Reset()
    {
        if (mapReady)
            await maps!.ResetMap(mapId, Logger, ToastService, mapOptions);
    }

    private void ShowOverlay(bool isVisible)
    {
        overlay = isVisible;
        StateHasChanged();
    }

    #endregion
}
