@page "/map-dds-method-CaseGet"
@rendermode InteractiveServer
@inject ILogger<CaseGet> Logger
@inject INotificationService ToastService
@inject AzureMapsXmlDocReader DocReader

<MapPage Title="@title">
    <SummaryContent>
        <FluentLabel>@docItem?.Summary</FluentLabel>
    </SummaryContent>
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical">
            <Toolbar>
                <FluentButton IconStart="@((new Icons.Regular.Size20.CodeBlock()))" OnClick="@Build">Build</FluentButton>
            </Toolbar>

            <FluentTextInput Label="Has Property" Tooltip="@docHasProperty?.Value" @bind-Value="@hasProperty" />
            <FluentTextInput Label="Get Property" Tooltip="@docGetProperty?.Value" @bind-Value="@getProperty" />
            <FluentTextInput Label="Default Value" Tooltip="@docDefaultValue?.Value" @bind-Value="@defaultValue" />

            <FluentLabel>Build Result as Json: @result</FluentLabel>
        </FluentStack>
    </ChildContent>
</MapPage>

@code {
    private const string name = nameof(DDSBuilder.CaseGet);
    private string title => $"DDS - {name}";
    private XmlDocumentMember? docItem;
    private XmlDocumentMemberParameter? docHasProperty;
    private XmlDocumentMemberParameter? docGetProperty;
    private XmlDocumentMemberParameter? docDefaultValue;
    private string? hasProperty = "myHasPropertyName";
    private string? getProperty = "myGetPropertyName";
    private string? defaultValue = "myDefaultValue";
    private string? result;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var members = DocReader.GetMembers(typeof(DDSBuilder));
            docItem = members.GetMembersWithName(name).FirstOrDefault();
            docHasProperty = docItem?.GetParameterByName("hasProperty");
            docGetProperty = docItem?.GetParameterByName("getProperty");
            docDefaultValue = docItem?.GetParameterByName("defaultValue");
        }
        catch (Exception ex)
        {
            await Logger.HandleErrorWithToast(ex, ToastService);
        }
    }

    private async Task Build()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(hasProperty))
            {
                await Logger.HandleWarningWithToast("Please provide a value for 'Has Property'.", ToastService);
                return;
            }

            if (string.IsNullOrWhiteSpace(getProperty))
            {
                await Logger.HandleWarningWithToast("Please provide a value for 'Get Property'.", ToastService);
                return;
            }

            result = DDSBuilder.CaseGet(hasProperty, getProperty, defaultValue ?? "", returnJson: true).ToString();
        }
        catch (Exception ex)
        {
            await Logger.HandleErrorWithToast(ex, ToastService);
        }
    }
}
