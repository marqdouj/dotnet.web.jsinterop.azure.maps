@page "/map-dds-method-ConcatGet"
@rendermode InteractiveServer
@inject ILogger<ConcatGet> Logger
@inject INotificationService ToastService
@inject AzureMapsXmlDocReader DocReader

<MapPage Title="@title">
    <SummaryContent>
        <FluentLabel>@docItem?.Summary</FluentLabel>
    </SummaryContent>
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical">
            <Toolbar>
                <FluentButton IconStart="@((new Icons.Regular.Size20.CodeBlock()))" OnClick="@Build">Build</FluentButton>
            </Toolbar>

            <FluentTextInput @bind-Value="@getProperty" Label="@docGetProperty?.DisplayName" LabelInfo="@(LabelInfo.WithText(docGetProperty?.Value!))" />
            <FluentTextInput @bind-Value="@concatValue" Label="@docConcatenateValue?.DisplayName" LabelInfo="@(LabelInfo.WithText(docConcatenateValue?.Value!))" />

            <FluentLabel>Build Result as Json: @result</FluentLabel>
        </FluentStack>
    </ChildContent>
</MapPage>

@code {
    private const string name = nameof(DDSBuilder.ConcatGet);
    private string title => $"DDS - {name}";
    private XmlDocumentMember? docItem;
    private XmlDocumentMemberParameter? docGetProperty;
    private XmlDocumentMemberParameter? docConcatenateValue;
    private string? concatValue = "°C";
    private string? getProperty = "temperature";
    private string? result;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var members = DocReader.GetMembers(typeof(DDSBuilder));
            docItem = members.GetMembersWithName(name).FirstOrDefault();
            docGetProperty = docItem?.GetParameterByName(nameof(ConcatGetStyleBuilder.GetProperty));
            docConcatenateValue = docItem?.GetParameterByName(nameof(ConcatGetStyleBuilder.ConcatenateValue));
        }
        catch (Exception ex)
        {
            await Logger.HandleErrorWithToast(ex, ToastService);
        }
    }

    private async Task Build()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(getProperty))
            {
                await Logger.HandleWarningWithToast("Please provide a value for 'Get Property'.", ToastService);
                return;
            }

            if (string.IsNullOrWhiteSpace(concatValue))
            {
                await Logger.HandleWarningWithToast("Please provide a value for 'Concatenate Value'.", ToastService);
                return;
            }

            result = DDSBuilder.ConcatGet(getProperty, concatValue, returnJson: true).ToString();
        }
        catch (Exception ex)
        {
            await Logger.HandleErrorWithToast(ex, ToastService);
        }       
    }
}