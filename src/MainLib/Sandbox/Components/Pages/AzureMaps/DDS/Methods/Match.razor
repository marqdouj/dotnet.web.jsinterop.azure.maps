@page "/map-dds-method-Match"
@rendermode InteractiveServer
@inject ILogger<Match> Logger
@inject INotificationService ToastService
@inject AzureMapsXmlDocReader DocReader

<MapPage Title="@title">
    <SummaryContent>
        <FluentLabel>@docItem?.Summary</FluentLabel>
    </SummaryContent>
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical">
            <FluentLabel>
                See the&nbsp;
                <FluentLink Href="map-acme-pipelines">Acme Pipelines Example</FluentLink>
            </FluentLabel>
            <br />
            <FluentLabel>Code Snippet:</FluentLabel>
            <code><pre>@snippet</pre></code>
        </FluentStack>
    </ChildContent>
</MapPage>

@code {
    private const string name = nameof(DDSBuilder.Match);
    private string title => $"DDS - {name}";
    private XmlDocumentMember? docItem;
    private string? result;
    private string snippet = """
var colorBuilder = DDSBuilder.Match(
    "category",
    new List<(string Case, string Value)>
    {
        ("mainline", mainlineColor),
        ("lateral", lateralColor)
    },
    "blue"
);

pipelinesLayer.Options = new()
{
    StrokeColor = colorBuilder,
    StrokeWidth = 3.5
};
""";
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var members = DocReader.GetMembers(typeof(DDSBuilder));
            docItem = members.GetMembersWithName(name).FirstOrDefault();
        }
        catch (Exception ex)
        {
            await Logger.HandleErrorWithToast(ex, ToastService);
        }
    }

    private async Task Build()
    {
        try
        {
            result = "TODO:"; // DDSBuilder.???;
        }
        catch (Exception ex)
        {
            await Logger.HandleErrorWithToast(ex, ToastService);
        }       
    }
}