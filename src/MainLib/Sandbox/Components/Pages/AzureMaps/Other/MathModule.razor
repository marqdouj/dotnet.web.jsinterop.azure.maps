            List<List<double>> sourcePointsL = [
                [0, 0],
                [100, 0],
                [0, 100]
            ];

            List<List<double>> targetPointsL = [
                [10, 20],
                [110, 20],
                [10, 120]
            ];

            List<List<double>> targetPointL = [[60, 70]];

            var data = await maps!.Math.GetAffineTransformToSource(sourcePoints, targetPoints, targetPoint);
            var dataL = await maps!.Math.GetAffineTransformToSource(sourcePointsL, targetPointsL, targetPointL);
            result.Result = $"{JsonSerializer.Serialize(data)} {JsonSerializer.Serialize(dataL)}";
            result.Status = MathTestRunStatus.Success;
        }
        catch (Exception ex)
        {
            result.Status = MathTestRunStatus.Failed;
            result.Exception = ex;
