    private class MathTestRun(MathTest test)
    {
        public MathTest MathTest { get; } = test;
        public string Name => MathTest.ToString();
        public MathTestRunStatus Status { get; set; }
        public string? Result { get; set; }
        public Exception? Exception { get; set; }
        public string? Error => Exception?.Message;
    }

    private enum MathTestRunStatus
    {
        None,
        Success,
        Failed,
    }

    private enum MathTest
    {
        BoundingBoxToPolygon,
        ConvertAcceleration,
        ConvertArea,
        ConvertDistance,
        ConvertSpeed,
        ConvertTimespan,
        GetAcceleration,
        GetAccelerationFromFeatures,
        GetAccelerationFromSpeeds,
        GetAffineTransformToSource,
        GetAffineTransformToTarget,
        GetArea,
        GetCardinalSpline,
        GetClosestPointOnGeometry,
        GetConvexHull,
        GetDestination,
        GetDistanceTo,
        GetEarthRadius,
        GetGeodesicPath,
        GetGeodesicPaths,
        GetHeading,
        GetLengthOfPath,
        GetPathDenormalizedAtAntimerian,
        GetPathSplitByAntimeridian,
        GetPixelHeading,
        GetPointsWithHeadingAlongPath,
        GetPointWithHeadingAlongPath,
        GetPosition,
        GetPositionAlongPath,
        GetPositions,
        GetPositionsAlongPath,
        GetRegularPolygonPath,
        GetRegularPolygonPaths,
        GetSpeed,
        GetSpeedFromFeatures,
        GetTravelDistance,
        Interpolate,
        MercatorPixelsToPositions,
        MercatorPositionsToPixels,
        NormalizeLatitude,
        NormalizeLongitude,
        RotatePositions,
        SimplifyPixels,
        SimplifyPositions,
    }

    #endregion

    #region Map Provider Handlers

    private async Task OnMapProviderInitialized(MapProviderArgs args)
    {
        try
        {
            maps = await args.ProcessMapProviderInitialized(Logger, ToastService);
            if (maps != null)
            {
                await maps.CreateDefaultMap(mapId, Logger, ToastService, mapOptions);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task OnMapEventError(MapEventArgs args)
    {
        await args.ProcessMapEventError(Logger, ToastService);
    }

    private async Task OnMapEventReady(MapEventArgs args)
    {
        try
        {
            mapReady = !(await args.HasPayloadError(Logger, ToastService));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    # endregion

    #region MapsInterop

    private async Task Reset()
    {
        if (mapReady)
        {
            await maps!.ResetMap(mapId, Logger, ToastService, mapOptions);
        }
    }

    private void ShowOverlay(bool isVisible)
    {
        overlay = isVisible;
        StateHasChanged();
    }

    #endregion
}
