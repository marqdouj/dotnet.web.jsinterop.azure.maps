    #region Math Tests

    private async Task RunTests()
    {
        try
        {
            ShowOverlay(true);
            testRuns = [];
            StateHasChanged();

            var tests = new List<MathTestRun>();

            tests.Add(await BoundingBoxesToPolygonsTest());
            tests.Add(await ConvertAccelerationTest());
            tests.Add(await ConvertAreaTest());
            tests.Add(await ConvertDistancesTest());
            tests.Add(await ConvertSpeedTest());
            tests.Add(await ConvertTimeSpanTest());
            tests.Add(await GetAccelerationTest());
            tests.Add(await GetAccelerationFromFeaturesTest());
            tests.Add(await GetAccelerationFromSpeedsTest());
            tests.Add(await GetAffineTransformToSourceTest());
            tests.Add(await GetAffineTransformToTargetTest());
            tests.Add(await GetAreaTest());
            tests.Add(await GetCardinalSplineTest());
            tests.Add(await GetClosestPointOnGeometryTest());
            tests.Add(await GetConvexHullTest());
            tests.Add(await GetDestinationTest());
            tests.Add(await GetDistanceToTest());
            tests.Add(await GetEarthRadiusTest());
            tests.Add(await GetGeodesicPathTest());
            tests.Add(await GetGeodesicPathsTest());
            tests.Add(await GetHeadingTest());
            tests.Add(await GetLengthOfPathTest());
            tests.Add(await GetPathDenormalizedAtAntimerianTest());
            tests.Add(await GetPathSplitByAntimeridianTest());
            tests.Add(await GetPixelHeadingTest());
            tests.Add(await GetPointsWithHeadingAlongPathTest());
            tests.Add(await GetPointWithHeadingAlongPathTest());
            tests.Add(await GetPositionTest());
            tests.Add(await GetPositionAlongPathTest());
            tests.Add(await GetPositionsTest());
            tests.Add(await GetPositionsAlongPathTest());
            tests.Add(await GetRegularPolygonPathTest());
            tests.Add(await GetRegularPolygonPathsTest());
            tests.Add(await GetSpeedTest());
            tests.Add(await GetSpeedFromFeaturesTest());
            tests.Add(await GetTravelDistanceTest());
            tests.Add(await InterpolateTest());
            tests.Add(await MercatorPixelsToPositionsTest());
            tests.Add(await MercatorPositionsToPixelsTest());
            tests.Add(await NormalizeLatitudeTest());
            tests.Add(await NormalizeLongitudeTest());
            tests.Add(await RotatePositionsTest());
            tests.Add(await SimplifyPixelsTest());
            tests.Add(await SimplifyPositionsTest());

            testRuns = tests;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            ShowOverlay(false);
        }
    }

