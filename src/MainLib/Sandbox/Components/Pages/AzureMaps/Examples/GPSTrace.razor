@page "/map-examples-gps-trace"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject ILogger<GPSTrace> Logger
@inject INotificationService ToastService
@inject IMapDataService MapDataService

<MapPage Title="Example (GPS Trace)">
    <SummaryContent>
        <FluentText>
            This sample shows how to smoothly animate a symbol along a route path taking into 
            consideration timestamps for each point in the route path.
            <br />
            <br />
            NOTE: The source GPS was downloaded from the Azure Maps Samples website, however some of the data does not display well and appears to be corrupted
            (which is how it appears in the azure maps sample as well).
            However, the sample still demonstrates how to animate a symbol along a route path using timestamps for each point in the route path.
            <br />
            <br />
            Based on this <a href="@sourceUrl" target="_blank">article</a>
            <br />
            Article source code: <a href="@codeUrl" target="_blank">article</a>
        </FluentText>
    </SummaryContent>
    <ChildContent>
        <Toolbar>
            <FluentButton Disabled="@buttonsDisabled" IconStart="@(new Icons.Regular.Size20.ArrowReset())" Title="Reset" OnClick="@Reset" />
            <FluentSpacer Width="5px"/>
            <FluentSelect  Label="Dataset:" LabelPosition="LabelPosition.Before"
                           Items="@datasets"
                           OptionText="@(item => item.DisplayName)"
                           TOption="DatasetInfo"
                           TValue="DatasetInfo"
                           Value="@value"
                          ValueChanged="OnDatasetInfoChanged"
                           Width="260px" />
            <FluentSpacer Width="5px" />
            <FluentLabel>Animation:</FluentLabel>
            <FluentSpacer Width="3px" />
            <FluentButton Disabled="@buttonsDisabled" IconStart="@(new Icons.Regular.Size20.Play())" Title="Play Animation" OnClick="@PlayAnimation" />
            <FluentButton Disabled="@buttonsDisabled" IconStart="@(new Icons.Regular.Size20.Pause())" Title="Pause Animation" OnClick="@PauseAnimation" />
            <FluentButton Disabled="@buttonsDisabled" IconStart="@(new Icons.Regular.Size20.Stop())" Title="Stop Animation" OnClick="@StopAnimation" />
            <FluentButton Disabled="@buttonsDisabled" IconStart="@(new Icons.Regular.Size20.ArrowReset())" Title="Reset Animation" OnClick="@ResetAnimation" />
            <FluentSpacer Width="5px" />
            <FluentCheckbox Value="@follow" ValueChanged="OnFollowChanged" Label="Follow Trace:" LabelPosition="LabelPosition.Before" />
            <FluentSpacer Width="5px" />
            <FluentSelect Label="Speed:" , LabelPosition="LabelPosition.Before"
                          Items="@speeds"
                          TOption="double"
                          TValue="double"
                          OptionText="@(e => $"{e}x")"
                          Value="@speed"
                          ValueChanged="OnSpeedChanged" />
        </Toolbar>

        <FluentStack Height="100%">
            @if (panelInfo.HasPayload)
            {
                <div style="padding:3px;width:260px;">
                    @if (panelInfo.HasPayload)
                    {
                        <b>Timestamp:</b>
                        <br />
                        @panelInfo.Timestamp
                        <br /><br />
                        <b>Event details:</b>
                        <br />
                        <table>
                            <tr><td>type</td><td>@panelInfo.Type</td></tr>
                            <tr><td>progress</td><td>@panelInfo.Progress</td></tr>
                            <tr><td>easingProgress</td><td>@panelInfo.EasingProgress</td></tr>
                            <tr><td>heading</td><td>@panelInfo.Heading</td></tr>
                            <tr><td>speed (m/s)</td><td>@panelInfo.Speed</td></tr>
                            <tr><td>speed (km/hr)</td><td>@panelInfo.SpeedInKph</td></tr>
                            <tr><td>position</td><td>@panelInfo.PositionDisplay</td></tr>
                        </table>
                    }
                </div>
            }

            <MapContainer MapId="@mapId" />
        </FluentStack>

        <FluentOverlay @bind-Visible="@overlay" FullScreen="true">
            <FluentSpinner />
        </FluentOverlay>
    </ChildContent>
</MapPage>

<MapProvider OnMapProviderInitialized="@OnMapProviderInitialized"
             OnMapEvent="@OnMapEvent"
             OnMapEventError="@OnMapEventError"
             OnMapEventReady="@OnMapEventReady" />

@code {
    private const string sourceUrl = "https://samples.azuremaps.com/animations/animate-a-gps-trace";
    private const string codeUrl = "https://github.com/Azure-Samples/AzureMapsCodeSamples/blob/main/Samples/Animations/Animate%20a%20GPS%20trace/Animate%20a%20GPS%20trace.html";
    private readonly string mapId = "mapGPSTrace";
    private IAzureMapsInterop? maps;
    private bool mapReady;
    private bool mapNotReady => !mapReady;
    private bool overlay;
    private bool buttonsDisabled => mapNotReady | overlay;
    private MapOptions mapOptions = MapExtensions.GetDefaultMapOptions();
    private List<DatasetInfo> datasets = [];
    private DatasetInfo? value => datasets.FirstOrDefault();
    private readonly SimpleDataLayer routeLayer = new();
    private readonly SymbolLayer pinLayer = new();
    private readonly ImageTemplate image = new ImageTemplate("arrow-icon", ImageTemplateName.marker_arrow) { Color = "teal", SecondaryColor = "#fff" };
    private readonly PanelInfo panelInfo = new();
    private readonly List<double> speeds = [0.5, 1, 2, 5, 15, 30, 60, 100, 3600];
    private double speed = 15;
    private bool follow = true;
    private DotNetObjectReference<GPSTrace>? dotNetRef;
    private const string animationId = "gpsTrace";

    protected override void OnInitialized()
    {
        dotNetRef = DotNetObjectReference.Create(this);
        datasets = [
            new DatasetInfo("GPS Trace (GeoJSON)", "examples/GpsTrace.json"){ TimestampProperty = "time" },
            new DatasetInfo("Hurricane Barry track (csv)", "examples/hurricane_barry_track.csv") { TimestampProperty = "Date" },
            new DatasetInfo("Kuhkopfsteig trail (GPX)", "examples/kuhkopfsteig-fv.xml") { ValueInterpolations =  [ new PointPairValueInterpolation( "ele") ] },
            new DatasetInfo("Bike race GPS trace (GPX)", "examples/race-gps-trace.xml"){ ValueInterpolations =  [ new PointPairValueInterpolation( "ele") ] },
    ];
    }

    private async Task OnDatasetInfoChanged(DatasetInfo info)
    {
        await LoadGPSTrace(info);
    }

    private async Task OnOptionsChanged()
    {
        try
        {
            await maps!.Animations.SetOptions(mapId, animationId, new RoutePathAnimationOptions { SpeedMultiplier = speed, MapId = follow ? mapId : "" });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task OnSpeedChanged(double value)
    {
        speed = value;
        await OnOptionsChanged();
    }

    private async Task OnFollowChanged(bool value)
    {
        follow = value;
        await OnOptionsChanged();
    }

    private async Task PlayAnimation()
    {
        try
        {
            await maps!.Animations.UpdateAnimation(mapId, animationId, "play");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task PauseAnimation()
    {
        try
        {
            await maps!.Animations.UpdateAnimation(mapId, animationId, "pause");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task StopAnimation()
    {
        try
        {
            await maps!.Animations.UpdateAnimation(mapId, animationId, "stop");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task ResetAnimation()
    {
        try
        {
            await maps!.Animations.UpdateAnimation(mapId, animationId, "reset");
            panelInfo.Update(null);
            await Reset();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task LoadGPSTrace(DatasetInfo info)
    {
        try
        {
            ShowOverlay(true);
            panelInfo.Update(null);

            var events = new List<MapEvent> { new MapEvent(MapEventType.OnProgress, MapEventTarget.animation) { TargetId = animationId } };
            var readOptions = new SpatialDataReadOptions { CapturePathWaypoints = true };
            var pathOptions = new RoutePathAnimationOptions() { CaptureMetadata = true, SpeedMultiplier = speed, ValueInterpolations = info.ValueInterpolations, Pitch = 45, Zoom = info.Zoom };
            var args = new LoadGPSTraceParameters(animationId, routeLayer.Source.Id, pinLayer.Source.Id, info.Url, info.TimestampProperty, readOptions, pathOptions, events, follow);
            var results = await maps!.Spatial.Sources.LoadGPSTrace(mapId, args);

            if (results?.Bbox != null)
            {
                var options = await maps.Configuration.GetMapOptions(mapId, new MapOptionsArgs(camera: true));
                if (options?.Camera != null)
                    mapOptions.Camera = options!.Camera;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            ShowOverlay(false);
        }
    }

    #region Map Provider Handlers

    private async Task OnMapProviderInitialized(MapProviderArgs args)
    {
        try
        {
            maps = await args.ProcessMapProviderInitialized(Logger, ToastService);
            if (maps != null)
                await maps.CreateDefaultMap(mapId, Logger, ToastService, mapOptions);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task OnMapEventError(MapEventArgs args)
    {
        await args.ProcessMapEventError(Logger, ToastService);
    }

    private async Task OnMapEventReady(MapEventArgs args)
    {
        mapReady = !(await args.HasPayloadError(Logger, ToastService));

        if (mapReady)
        {
            try
            {
                ShowOverlay(true);

                pinLayer.Options = new() { 
                    IconOptions = new() 
                    { 
                        ImageId = image.Id,
                        Anchor = "center",
                        Rotation = new List<object> { "+", 180, new List<string> { "get", "heading" } },
                        RotationAlignment = SymbolItemAlignment.map,
                        IgnorePlacement = true,
                        AllowOverlap = true
                    },
                    TextOptions = new()
                    {
                        IgnorePlacement = true,
                        AllowOverlap = true
                    }
                };

                await maps!.Sprites.CreateFromTemplate(mapId, image);
                //The order the layers are added is important.
                //We need the pin to display above the data so dataLayer must be added first.
                await maps.Spatial.Layers.Add(mapId, routeLayer);
                await maps.Layers.Add(mapId, pinLayer);
                await LoadGPSTrace(datasets[0]);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "");
                await ToastService.ShowError(ex.Message);
            }
            finally
            {
                ShowOverlay(false);
            }
        }
    }

    private async Task OnMapEvent(MapEventArgs args)
    {
        try
        {
            panelInfo.Update(args.Payload?.Animation?.PlayableEvent);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
    }
    # endregion

    #region MapsInterop

    private async Task Reset()
    {
        if (mapReady)
        {
            await maps!.ResetMap(mapId, Logger, ToastService, mapOptions);
        }
    }

    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
    }

    #endregion

    private void ShowOverlay(bool isVisible)
    {
        overlay = isVisible;
        StateHasChanged();
    }

    private class PanelInfo : PlayableAnimationEvent
    {
        public void Update(PlayableAnimationEvent? payload)
        {
            HasPayload = payload != null;

            Type = payload?.Type ?? "";
            Progress = Math.Round(payload?.Progress ?? 0, 8);
            EasingProgress = Math.Round(payload?.EasingProgress ?? 0, 8);
            Heading = Math.Round(payload?.Heading ?? 0, 6);
            Speed = Math.Round(payload?.Speed ?? 0, 8);
            SpeedInKph = Math.Round(payload?.SpeedInKph ?? 0, 8);
            Position = payload?.Position;
            Timestamp = payload?.Timestamp;

            PositionDisplay = this.Position is not null ? $"[{Position.Longitude:F6}, {Position.Latitude:F6}]" : null;
            
        }

        public string? PositionDisplay { get; private set; }

        public bool HasPayload { get; private set; }
    }

    private class DatasetInfo(string displayName, string url)
    {
        public string DisplayName { get; } = displayName;
        public string Url { get; } = url;
        public string? TimestampProperty { get; set; }
        public List<PointPairValueInterpolation>? ValueInterpolations { get; set; }
        public double Zoom { get; set; } = 15;
    }
}
