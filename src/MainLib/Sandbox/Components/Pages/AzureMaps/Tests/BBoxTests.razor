    #region Math Tests

    private async Task RunTests()
    {
        try
        {
            ShowOverlay(true);

            var tests = new List<MathTestRun>();

            tests.Add(await ContainsPositionTest());
            tests.Add(await CrossesAntimeridianTest());
            tests.Add(await FromBoundingBoxTest());
            tests.Add(await FromDataTest());
            tests.Add(await FromDimensionsTest());
            tests.Add(await FromEdgesTest());
            tests.Add(await FromLatLngsTest());
            tests.Add(await FromPositionsTest());
            tests.Add(await GetCenterTest());
            tests.Add(await GetEastTest());
            tests.Add(await GetHeightTest());
            tests.Add(await GetNorthTest());
            tests.Add(await GetNorthEastTest());
            tests.Add(await GetNorthWestTest());
            tests.Add(await GetSouthTest());
            tests.Add(await GetSouthEastTest());
            tests.Add(await GetSouthWestTest());
            tests.Add(await GetWestTest());
            tests.Add(await GetWidthTest());
            tests.Add(await IntersectTest());
            tests.Add(await MergeTest());
            tests.Add(await SplitOnAntimeridianTest());


            testRuns = tests;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            ShowOverlay(false);
        }
    }

    private async Task<MathTestRun> ContainsPositionTest()
    {
        var result = new MathTestRun(nameof(ContainsPositionTest));

        try
        {
            var data = await maps!.Data.BoundingBox.ContainsPosition(bbox, bbox.Northeast!);
            result.Status = data ? MathTestRunStatus.Success : MathTestRunStatus.Failed;
        }
        catch (Exception ex)
        {
            result.Status = MathTestRunStatus.Failed;
            result.Exception = ex;
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }

        return result;
    }

