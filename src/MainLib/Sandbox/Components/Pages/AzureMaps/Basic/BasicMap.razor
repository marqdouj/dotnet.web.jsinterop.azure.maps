@page "/map-basic-map"
@rendermode InteractiveServer
@inject ILogger<BasicMap> Logger
@inject INotificationService ToastService
@inject IDialogService DialogService

<MapPage Title="Basic Map">
    <SummaryContent>
        <MapPageSummary>
            This sample demonstrates how to create a basic map and interact with it using the Azure Maps Controls. 
            Use the buttons in the toolbar to reset the map, or adjust various map settings.
        </MapPageSummary>
    </SummaryContent>
    <ChildContent>
        <Toolbar>
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.ArrowReset())" Title="Reset" OnClick="@Reset" />
            <FluentSpacer Width="10px" />
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.Camera())" Title="Camera Settings" OnClick="@(() => ShowSettings(MapSettingsDisplay.Camera))" />
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.ServerLink())" Title="Style Settings" OnClick="@(() => ShowSettings(MapSettingsDisplay.Style))" />
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.TextEditStyle())" Title="Service Settings" OnClick="@(() => ShowSettings(MapSettingsDisplay.Service))" />
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.VehicleCar())" Title="Traffic Settings" OnClick="@(() => ShowSettings(MapSettingsDisplay.Traffic))" />
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.Person())" Title="User Interaction Settings" OnClick="@(() => ShowSettings(MapSettingsDisplay.UserInteraction))" />
        </Toolbar>

        <MapControl MapId="@mapId" />

        <FluentOverlay @bind-Visible="@overlay" FullScreen="true">
            <FluentSpinner />
        </FluentOverlay>
    </ChildContent>
</MapPage>

<MapProvider OnMapProviderInitialized="@OnMapProviderInitialized"
             OnMapEventError="@OnMapEventError"
             OnMapEventReady="@OnMapEventReady" />

@code {
    private const string mapId = "mapBasic";
    private IAzureMapsInterop? maps;
    private bool mapReady;
    private bool mapNotReady => !mapReady;
    private bool overlay;
    private bool buttonsDisabled => mapNotReady | overlay;
    private MapOptionsData? settings;

    #region Map Provider Handlers

    private async Task OnMapProviderInitialized(MapProviderArgs args)
    {
        try
        {
            maps = await args.ProcessMapProviderInitialized(Logger, ToastService);
            if (maps != null)
                await maps.CreateDefaultMap(mapId, Logger, ToastService);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task OnMapEventError(MapEventArgs args)
    {
        await args.ProcessMapEventError(Logger, ToastService);
    }

    private async Task OnMapEventReady(MapEventArgs args)
    {
        try
        {
            mapReady = !(await args.HasPayloadError(Logger, ToastService));
            ShowOverlay(true);
            settings = new MapOptionsData(await maps!.Configuration.GetMapOptions(mapId));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            ShowOverlay(false);
        }
    }

    # endregion

    #region MapsInterop

    private async Task Reset()
    {
        if (mapReady)
            await maps!.ResetMap(mapId, Logger, ToastService);
    }

    private async Task ShowSettings(MapSettingsDisplay display = MapSettingsDisplay.All)
    {
        try
        {
            settings!.Display = display;

            var result = await DialogService.ShowDialogAsync<MapSettings>(options =>
            {
                options.Parameters.Add(nameof(MapSettings.Options), settings);
                options.Width = "800px";
            });

            if (!result.Cancelled)
            {
                var data = settings!.ToMapOptionsEdit();
                await maps!.Configuration.SetMapOptions(mapId, data);
                await ToastService.ShowInfo("Settings updated.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            ShowOverlay(false);
        }
    }

    private void ShowOverlay(bool isVisible)
    {
        overlay = isVisible;
        StateHasChanged();
    }

    #endregion
}
