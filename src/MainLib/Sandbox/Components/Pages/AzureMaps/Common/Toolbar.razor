<FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="@HorizontalGap">
    @ChildContent
</FluentStack>

@code {
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public string? HorizontalGap { get; set; } = "5px";
}
