@page "/design"
@rendermode InteractiveServer
@inject ILogger<Design> Logger
@inject IToastService ToastService

<MapPage Title="Design">
    <SummaryContent>
        <MapPageSummary />
    </SummaryContent>
    <ChildContent>
        <Toolbar>
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.ArrowReset())" Title="Reset" OnClick="@Reset" />
            <FluentMenu>
                <FluentMenuButton Label="Menu: ">@activeMenu</FluentMenuButton>
                @RenderMenuItems()
            </FluentMenu>
        </Toolbar>

        <MapControl MapId="@mapId" />
    </ChildContent>
</MapPage>

<MapProvider OnMapProviderInitialized="@OnMapProviderInitialized"
             OnMapEventError="@OnMapEventError"
             OnMapEventReady="@OnMapEventReady" />

@code {
    private const string mapId = "mapDesign";
    private IAzureMapsInterop? maps;
    private bool mapReady;
    private bool mapNotReady => !mapReady;
    private string? activeMenu = "";

    private async Task MenuClick(string? item)
    {
        await Task.CompletedTask;

        activeMenu = item;
        Console.WriteLine(activeMenu);
    }


    RenderFragment RenderMenuItems() =>
        @<FluentMenuList>
            <FluentMenuItem OnClick="@(() => MenuClick("Menu item 1"))">Menu item 1</FluentMenuItem>
            <FluentMenuItem OnClick="@(() => MenuClick("Menu item 2"))">Menu item 2</FluentMenuItem>
            <FluentMenuItem OnClick="@(() => MenuClick("Menu item 3"))">Menu item 3</FluentMenuItem>
            <FluentMenuItem OnClick="@(() => MenuClick("Menu item 4"))">Menu item 4</FluentMenuItem>
        </FluentMenuList>;

    #region Map Provider Handlers

    private async Task OnMapProviderInitialized(MapProviderArgs args)
    {
        try
        {
            maps = await args.ProcessMapProviderInitialized(Logger, ToastService);
            if (maps != null)
                await maps.CreateDefaultMap(mapId, Logger, ToastService);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task OnMapEventError(MapEventArgs args)
    {
        await Task.CompletedTask;
        await args.ProcessMapEventError(Logger, ToastService);
    }

    private async Task OnMapEventReady(MapEventArgs args)
    {
        await Task.CompletedTask;
        mapReady = !(await args.HasPayloadError(Logger, ToastService));
    }

    # endregion

    #region MapsInterop

    private async Task Reset()
    {
        if (mapReady)
            await maps!.ResetMap(mapId, Logger, ToastService);
    }

    #endregion
}
