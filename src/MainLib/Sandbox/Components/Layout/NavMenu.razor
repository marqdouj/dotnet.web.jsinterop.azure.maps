@rendermode InteractiveServer
@inject AppConfiguration AppConfig

<FluentNav Id="main-menu" UseSingleExpanded="true" Width="265px">
    @if (AppConfig.IsDevelopment)
    {
        <FluentNavItem Href="design" IconRest="@((new Icons.Regular.Size20.DesignIdeas()))">Design</FluentNavItem>
    }
    <FluentNavItem Href="/" IconRest="@((new Icons.Regular.Size20.Home()))">Home</FluentNavItem>

    <FluentNavCategory Title="Basic" IconRest="@((new Icons.Regular.Size20.NotePin()))" IconActive="@((new Icons.Filled.Size20.NotePin()))">
        <FluentNavItem Href="map-basic-map" IconRest="@((new Icons.Regular.Size20.Map()))">Basic Map</FluentNavItem>
        <FluentNavItem Href="map-basic-layers" IconRest="@(new Icons.Regular.Size20.Layer())">Basic Map (Layers)</FluentNavItem>
        <FluentNavItem Href="map-basic-multi" IconRest="@(new Icons.Regular.Size20.Multiplier2x())">Basic Map (Multiple)</FluentNavItem>
    </FluentNavCategory>

    <FluentNavCategory Title="Custom (JS Interop)" IconRest="@((new Icons.Regular.Size20.NotePin()))" IconActive="@((new Icons.Filled.Size20.NotePin()))">
        <FluentNavItem Href="map-custom-controls" IconRest="@(new Icons.Regular.Size20.DesignIdeas())">Controls</FluentNavItem>
    </FluentNavCategory>

    <FluentNavCategory Title="Data-Driven Styling (DDS)" IconRest="@((new Icons.Regular.Size20.NotePin()))" IconActive="@((new Icons.Filled.Size20.NotePin()))">
        <FluentNavItem Href="map-dds-general" IconRest="@(new Icons.Regular.Size20.Toolbox())">DDS Builder</FluentNavItem>

        <FluentNavSectionHeader Title="Examples" />
        <FluentNavItem Href="map-dds-caseget" IconRest="@(new Icons.Regular.Size20.Code())">CaseGet</FluentNavItem>
        <FluentNavItem Href="map-acme-pipelines" IconRest="@(new Icons.Regular.Size20.Pipeline())">GeoJSON</FluentNavItem>
        <FluentNavItem Href="map-dds-temperatures" IconRest="@(new Icons.Regular.Size20.Temperature())">Temperatures</FluentNavItem>

        <FluentNavSectionHeader Title="Methods" />
        <FluentNavItem Href="map-dds-method-caseget" IconRest="@(new Icons.Regular.Size20.Code())">CaseGet</FluentNavItem>
        <FluentNavItem Href="map-dds-method-CoalesceGet" IconRest="@(new Icons.Regular.Size20.Code())">CoalesceGet</FluentNavItem>
        <FluentNavItem Href="map-dds-method-ConcatGet" IconRest="@(new Icons.Regular.Size20.Code())">ConcatGet</FluentNavItem>
        <FluentNavItem Href="map-dds-method-GeometryFilter" IconRest="@(new Icons.Regular.Size20.Code())">GeometryFilter</FluentNavItem>
        <FluentNavItem Href="map-dds-method-LinearInterpolate" IconRest="@(new Icons.Regular.Size20.Code())">LinearInterpolate</FluentNavItem>
        <FluentNavItem Href="map-dds-method-LiteralGet" IconRest="@(new Icons.Regular.Size20.Code())">LiteralGet</FluentNavItem>
        <FluentNavItem Href="map-dds-method-Match" IconRest="@(new Icons.Regular.Size20.Code())">Match</FluentNavItem>
    </FluentNavCategory>

    <FluentNavCategory Title="Events" IconRest="@((new Icons.Regular.Size20.NotePin()))" IconActive="@((new Icons.Filled.Size20.NotePin()))">
        <FluentNavItem Href="map-events-controls" IconRest="@(new Icons.Regular.Size20.Map())">Controls</FluentNavItem>
        <FluentNavItem Href="map-events-layers" IconRest="@(new Icons.Regular.Size20.Map())">Layers</FluentNavItem>
        <FluentNavItem Href="map-events-markers" IconRest="@(new Icons.Regular.Size20.Map())">Markers</FluentNavItem>
        <FluentNavItem Href="map-events-map" IconRest="@(new Icons.Regular.Size20.Map())">Map</FluentNavItem>
    </FluentNavCategory>

    <FluentNavCategory Title="Utilities" IconRest="@((new Icons.Regular.Size20.NotePin()))" IconActive="@((new Icons.Filled.Size20.NotePin()))">
        <FluentNavItem Href="map-utils-feature-convert" IconRest="@(new Icons.Regular.Size20.ConvertRange())">Feature Conversions</FluentNavItem>
        <FluentNavItem Href="map-utils-gps-calc" IconRest="@(new Icons.Regular.Size20.TableCalculator())">Gps Calculator</FluentNavItem>
        <FluentNavItem Href="map-utils-mercators" IconRest="@(new Icons.Regular.Size20.MathFormula())">Mercators</FluentNavItem>
    </FluentNavCategory>

    <FluentNavCategory Title="Other" IconRest="@((new Icons.Regular.Size20.NotePin()))" IconActive="@((new Icons.Filled.Size20.NotePin()))">
        <FluentNavItem Href="map-other-pizza-delivery" IconRest="@(new Icons.Regular.Size20.FoodPizza())">Pizza Delivery</FluentNavItem>
        <FluentNavItem Href="map-other-geolocation" IconRest="@(new Icons.Regular.Size20.GlobeLocation())">User Location</FluentNavItem>
    </FluentNavCategory>
</FluentNav>

