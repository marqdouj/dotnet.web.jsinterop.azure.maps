<FluentStack Orientation="@Orientation" HorizontalGap="@horizontalGapValue"
             HorizontalAlignment="HorizontalAlignment.Left"
             VerticalAlignment="VerticalAlignment.Center">
    <DocLabel Model="Model">@HeaderContent</DocLabel>
    @ChildContent
</FluentStack>

@code {
    private string? horizontalGapValue => HorizontalGap ?? "3px";

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public string? HorizontalGap { get; set; }

    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    [Parameter, EditorRequired]
    public CSDocumentItem Model { get; set; }

    [Parameter]
    public Orientation Orientation { get; set; } = Orientation.Vertical;
}
