<div style="@styleDiv"></div>

@code {
    private string styleDiv => $"width: {Width ?? "100%"}; height: 1px; padding: {Padding ?? "5px"}; border-top: {UIExtensions.ThinBorderStyle}";

    [Parameter]
    public string? Padding { get; set; }

    [Parameter]
    public string? Width { get; set; }
}
